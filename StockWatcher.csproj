<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>StockWatcher</AssemblyName>
    <RootNamespace>StockWatcher</RootNamespace>
    <Nullable>disable</Nullable>
    <LangVersion>9.0</LangVersion>
    <ApplicationIcon>app.ico</ApplicationIcon>
	<Version>1.1.3</Version>
	<AssemblyVersion>1.1.3.0</AssemblyVersion>
	<FileVersion>1.1.3.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- System.Net.Http ist in .NET Framework 4.8 im GAC, muss aber explizit referenziert werden -->
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <!-- Newtonsoft.Json: zuverlässig für .NET Framework 4.8 ohne Abhängigkeitskonflikte -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
